# Raw API dumps — large, regenerable, may contain sensitive ticket detail
gitlab-analysis/raw/

# Obsidian local workspace state — the repo root is the vault (see
# obsidian-vault/README.md). Shared config (plugins, appearance, graph) is
# tracked; per-machine window layout/cache is not.
.obsidian/workspace*
.obsidian/cache

# Office temp files
exports/~$*.docx

# Scratch diagram-render pipeline output (rendered PNGs, the local render
# harness HTML, and the save server's own request log) -- regenerable from
# the markdown via exports/render_diagrams.py, not tracked content.
exports/_diagram_renders/

# OS
Thumbs.db
.DS_Store

# Python
__pycache__/
*.pyc
